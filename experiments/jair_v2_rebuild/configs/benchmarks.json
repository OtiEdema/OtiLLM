      "licence": "Apache-2.0",
      "planned_n": 200,
      "task": "open-ended truthfulness QA"
    },
    "fever": {
      "source": "https://fever.ai/dataset/fever.html",
      "split": "development",
      "licence_note": "Verify dataset and Wikipedia evidence terms before release.",
      "planned_n": 200,
      "task": "claim verification"
    },
    "hotpotqa": {
      "source": "https://hotpotqa.github.io/",
      "split": "distractor validation",
      "licence": "CC BY-SA 4.0",
      "planned_n": 200,
      "task": "multi-hop QA with supporting evidence"
    },
    "natural_questions": {
      "source": "https://ai.google.com/research/NaturalQuestions/download",
      "split": "development",
      "licence": "CC BY-SA 3.0",
      "planned_n": 200,
      "task": "real-user QA over Wikipedia"
    },
    "xstest": {
      "source": "https://huggingface.co/datasets/walledai/XSTest",
      "split": "test",
      "licence": "CC BY 4.0",
      "planned_n": 450,
      "task": "refusal calibration and exaggerated-safety evaluation"
    }
  },
  "note": "Primary content benchmarks use 200 deterministic items each; XSTest uses the full 450-item suite. Frozen manifest metadata supersedes planned counts."
